  "test_categories": {
    "unit_tests": [
      {
        "component": "LLMManager",
        "test_name": "test_llm_initialization",
        "description": "Проверка инициализации LLM менеджера",
        "test_code": "\nfunc testLLMManagerInitialization() {\n    let manager = LLMManager()\n    XCTAssertNotNil(manager)\n    XCTAssertEqual(manager.isInitialized, false)\n}",
        "expected_result": "Менеджер создается успешно",
        "priority": "High"
      },
      {
        "component": "VisionManager",
        "test_name": "test_image_analysis",
        "description": "Проверка анализа изображений",
        "test_code": "\nfunc testImageAnalysis() {\n    let manager = VisionManager()\n    let testImage = UIImage(named: \"test_image\")!\n    \n    let expectation = XCTestExpectation(description: \"Image analysis\")\n    \n    manager.analyzeImage(testImage) { result in\n        XCTAssertNotNil(result)\n        XCTAssertTrue(result.confidence > 0.5)\n        expectation.fulfill()\n    }\n    \n    wait(for: [expectation], timeout: 10.0)\n}",
        "expected_result": "Изображение анализируется корректно",
        "priority": "High"
      },
      {
        "component": "WebViewManager",
        "test_name": "test_javascript_injection",
        "description": "Проверка внедрения JavaScript",
        "test_code": "\nfunc testJavaScriptInjection() {\n    let manager = WebViewManager()\n    let testScript = \"document.title\"\n    \n    let expectation = XCTestExpectation(description: \"JS injection\")\n    \n    manager.injectJavaScript(testScript) { result in\n        XCTAssertNotNil(result)\n        expectation.fulfill()\n    }\n    \n    wait(for: [expectation], timeout: 5.0)\n}",
        "expected_result": "JavaScript выполняется успешно",
        "priority": "Medium"
      },
      {
        "component": "ScreenCaptureManager",
        "test_name": "test_screen_capture",
        "description": "Проверка захвата экрана",
        "test_code": "\nfunc testScreenCapture() {\n    let manager = ScreenCaptureManager()\n    \n    let expectation = XCTestExpectation(description: \"Screen capture\")\n    \n    manager.captureScreen { image in\n        XCTAssertNotNil(image)\n        XCTAssertTrue(image.size.width > 0)\n        XCTAssertTrue(image.size.height > 0)\n        expectation.fulfill()\n    }\n    \n    wait(for: [expectation], timeout: 3.0)\n}",
        "expected_result": "Скриншот создается успешно",
        "priority": "High"
      },
      {
        "component": "ChatMessage",
        "test_name": "test_message_creation",
        "description": "Проверка создания сообщений чата",
        "test_code": "\nfunc testChatMessageCreation() {\n    let message = ChatMessage(\n        id: UUID(),\n        content: \"Test message\",\n        isUser: true,\n        timestamp: Date()\n    )\n    \n    XCTAssertEqual(message.content, \"Test message\")\n    XCTAssertTrue(message.isUser)\n    XCTAssertNotNil(message.timestamp)\n}",
        "expected_result": "Сообщение создается с корректными данными",
        "priority": "Low"
      }
    ],
    "integration_tests": [
      {
        "test_name": "test_llm_vision_integration",
        "description": "Интеграция LLM и Vision компонентов",
        "components": [
          "LLMManager",
          "VisionManager"
        ],
        "scenario": "\n1. Захватить скриншот экрана\n2. Передать изображение в VisionManager для анализа\n3. Отправить результаты анализа в LLMManager\n4. Получить текстовое описание от LLM\n5. Проверить корректность результата\n",
        "expected_result": "LLM корректно обрабатывает результаты анализа изображений",
        "priority": "High"
      },
      {
        "test_name": "test_web_automation_flow",
        "description": "Полный цикл веб-автоматизации",
        "components": [
          "WebViewManager",
          "VisionManager",
          "LLMManager"
        ],
        "scenario": "\n1. Загрузить веб-страницу в WebView\n2. Сделать скриншот страницы\n3. Проанализировать элементы через Vision\n4. Получить инструкции от LLM\n5. Выполнить автоматизированные действия\n6. Проверить результат\n",
        "expected_result": "Автоматизация веб-страницы выполняется успешно",
        "priority": "High"
      },
      {
        "test_name": "test_ai_roles_switching",
        "description": "Переключение между ролями ИИ",
        "components": [
          "AIRoleManager",
          "LLMManager"
        ],
        "scenario": "\n1. Инициализировать роль Планировщика\n2. Создать план задач\n3. Переключиться на роль Декомпозитора\n4. Разбить задачи на подзадачи\n5. Переключиться на роль Оркестратора\n6. Координировать выполнение\n",
        "expected_result": "Роли переключаются корректно и выполняют свои функции",
        "priority": "Medium"
      },
      {
        "test_name": "test_control_room_communication",
        "description": "Связь с Control Room бэкендом",
        "components": [
          "ControlRoomManager",
          "WebSocket"
        ],
        "scenario": "\n1. Установить WebSocket соединение\n2. Отправить команду в Control Room\n3. Получить ответ от бэкенда\n4. Обработать результат в iOS приложении\n5. Обновить UI\n",
